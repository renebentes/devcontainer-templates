{
  "id": "joomla-mariadb",
  "version": "1.0.0",
  "name": "Joomla & MariaDB",
  "description": "Develop Joomla! Extensions. Includes PHP, MariaDB (MySQL compatible), and Node.js.",
  "documentationURL": "https://github.com/renebentes/devcontainer-templates/tree/main/src/joomla-mariadb",
  "licenseURL": "https://github.com/renebentes/devcontainer-templates/blob/main/LICENSE",
  "publisher": "Rene Bentes Pinto",
  "options": {
    "phpVersion": {
      "type": "string",
      "description": "PHP version:",
      "proposals": [
        "8.3"
      ],
      "default": "8.3"
    },
    "joomlaVersion": {
      "type": "string",
      "description": "Joomla! version:",
      "proposals": [
        "5.4.0",
        "6.1.4",
        "6.2.0"
      ],
      "default": "6.1.4"
    }
  },
  "platforms": [
    "Joomla",
    "PHP",
    "MariaDB (MySQL Compatible)",
    "Node.js"
  ]
}
