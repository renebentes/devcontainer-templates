{
  "id": "joomla-mariadb",
  "version": "1.0.0",
  "name": "Joomla & MariaDB",
  "description": "Develop Joomla! Extensions. Includes PHP, MariaDB (MySQL compatible), Node.js",
  "documentationURL": "https://github.com/renebentes/devcontainer-templates/tree/main/src/joomla-mariadb",
  "licenseURL": "https://github.com/renebentes/devcontainer-templates/blob/main/LICENSE",
  "publisher": "Rene Bentes Pinto",
  "options": {
    "imageVariant": {
      "type": "string",
      "description": "PHP version (use -trixie variant on arm64/Apple Silicon):",
      "proposals": [
        "8.3-trixie"
      ],
      "default": "php8.3-trixie"
    },
    "joomlaVariant": {
      "type": "string",
      "description": "Joomla! version:",
      "proposals": [
        "5.4",
        "6.1",
        "6.2"
      ],
      "default": "6.1"
    }
  },
  "platforms": [
    "Joomla",
    "PHP",
    "MariaDB (MySQL Compatible)",
    "Node.js"
  ]
}
